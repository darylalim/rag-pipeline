# Copy to .env and set the three required values: MONGODB_URI, since the index
# lives in MongoDB Atlas; VOYAGE_API_KEY, since Voyage AI embeds and reranks;
# and ANTHROPIC_API_KEY, since Claude writes the answers (the README's Setup
# walks through all three). Everything else is optional.

# --- Required: the MongoDB Atlas cluster ---
# A credential, not a setting: .env is git-ignored, and the app never displays
# it. In Atlas: Connect -> Drivers -> Python, with your database user's
# password filled in, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# --- Required: Voyage AI, for embeddings and reranking ---
# Also a credential: an API key from the Voyage AI dashboard.
VOYAGE_API_KEY=

# --- Required: Anthropic, for the answers ---
# Also a credential: an API key from the Claude Console. `rag eval` uses it too,
# for the Claude model that grades each answer.
ANTHROPIC_API_KEY=

# --- Optional overrides (defaults shown) ---
# CHAT_MODEL=claude-sonnet-5-5    # the request is Claude Sonnet 5.5's (its lowest thinking setting); see the README
# MAX_TOKENS=1024                 # an answer cut off here ends with a note saying so
# EMBEDDING_MODEL=voyage-4-large  # a Voyage embedding model; a change re-embeds everything
# EMBEDDING_DIMENSIONS=1024       # vector width: 256, 512, 1024 or 2048; a change needs a new COLLECTION_NAME
# RETRIEVAL_K=4                   # chunks kept after reranking; each adds prompt time
# FETCH_K=20                      # candidates fetched before reranking
# RERANK_MODEL=rerank-3          # a Voyage reranker
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# DATA_DIR=./data
# MONGODB_DB=rag_db               # Atlas database holding the index
# COLLECTION_NAME=rag_docs        # Atlas collection holding the chunks and their vectors
# VECTOR_INDEX_NAME=vector_index  # Atlas Vector Search index over them; `rag ingest` creates it
# MONGODB_TIMEOUT_MS=10000        # how long to wait to reach the cluster before failing

# --- Optional: tracing to LangSmith (the README's "Tracing with LangSmith") ---
# Off unless true. On, each question is sent to LangSmith's cloud as one trace
# -- the question, every retrieved passage in full, the prompt and the answer
# -- under LANGSMITH_PROJECT, with LANGSMITH_API_KEY (below). Only true or false.
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=rag-pipeline  # the LangSmith project traces are filed under; the first trace creates it

# --- Optional: the LangSmith key, for tracing and `rag eval` ---
# Read when LANGSMITH_TRACING is true, and by `rag eval` (the README's
# "Evaluation"), which keeps its question set as a LangSmith dataset and each
# run as an experiment. A key is not a setting: it has no default, and nothing
# displays it.
# LANGSMITH_API_KEY=
