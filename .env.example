# Copy to .env to override a default; nothing here is required. There are no API
# keys: the three models run locally with MLX (Apple Silicon Mac) and load from
# the Hugging Face cache, and Chroma keeps the index on disk. Download each model
# once before the first run (the README's Setup lists all three):
#   uvx --from huggingface_hub hf download <model id>
# A model setting is a Hugging Face repo id, resolved from that cache, or a path
# to a model directory. Loading never downloads.

# --- Optional overrides (defaults shown) ---
# CHAT_MODEL=mlx-community/Qwen3.8-27B-4bit   # any mlx-lm chat checkpoint whose template accepts a system turn
# MAX_TOKENS=1024                 # an answer cut off here ends with a note saying so
# EMBEDDING_MODEL=mlx-community/Qwen3-VL-Embedding-2B-bf16   # a Qwen3-VL-Embedding checkpoint
# EMBEDDING_DIMENSIONS=2048       # vector width, up to the model's 2048; a change needs a new COLLECTION_NAME
# RETRIEVAL_K=4                   # chunks kept after reranking; each adds prompt time
# FETCH_K=20                      # candidates fetched before reranking
# RERANK_MODEL=mlx-community/Qwen3-VL-Reranker-2B-bf16   # a tied-embedding Qwen3-VL-Reranker checkpoint (the 2B, bf16 or quantized)
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# DATA_DIR=./data
# PERSIST_DIR=./chroma_db         # where Chroma keeps the index
# COLLECTION_NAME=rag_docs        # Chroma collection holding the vectors

# --- Optional: tracing to a self-hosted Phoenix (the README's "Tracing with Phoenix") ---
# Off while unset. Set it to the base URL of a Phoenix server you run --
# http://localhost:6006 for one started with
#   PHOENIX_HOST=127.0.0.1 PHOENIX_ALLOW_EXTERNAL_RESOURCES=false uvx --from arize-phoenix phoenix serve
# -- and each question is sent there as one trace. A trace holds the question,
# every retrieved passage in full, the prompt and the answer.
# PHOENIX_COLLECTOR_ENDPOINT=
# PHOENIX_PROJECT=rag-pipeline    # the Phoenix project traces are filed under
#
# LangSmith is no longer used. Delete any LANGSMITH_TRACING=true (or
# LANGCHAIN_TRACING_V2=true) that an earlier version of this file suggested:
# langchain-core still acts on it, and uploads every question -- the prompt,
# every retrieved passage and the answer -- to LangSmith's cloud.
